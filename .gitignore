# Swift Package Manager
#
# Xcode-managed SwiftPM builds output here - safe to ignore.
# Package.resolved is intentionally NOT ignored below - it pins exact
# dependency versions (e.g. GRDB) and should be committed for reproducible
# builds.
.build/
.swiftpm/

